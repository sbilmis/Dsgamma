            ",", "\"Bs_low.g_1\"", ",", "\"Bs_low.Gamma_1_keV\"", ",", 
            "\"Bs_high.f1\"", ",", "\"Bs_high.f2\"", ",", "\"Bs_high.g_2\"", 
            ",", "\"Bs_high.Gamma_2_keV\""}], "}"}]}], "]"}]], "Input"], 
  Cell[BoxData[RowBox[{RowBox[{"comparisonPath", "=", 
        RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"notebookPaperDir", 
              ",", "\"outputs\"", ",", 
              "\"corrected_transition_python_mathematica_comparison.csv\""}], 
            "}"}], "]"}]}], ";", RowBox[{"comparisonRows", "=", 
        RowBox[{"Import", "[", RowBox[{"comparisonPath", ",", "\"CSV\""}], 
          "]"}]}], ";", RowBox[{"comparisonAbsoluteDifferences", "=", 
        RowBox[{"parseNumericText", "/@", RowBox[
           {RowBox[{"Rest", "[", "comparisonRows", "]"}], 
            "\[LeftDoubleBracket]", RowBox[{"All", ",", "4"}], 
            "\[RightDoubleBracket]"}]}]}], ";", 
      RowBox[{"comparisonPassed", "=", RowBox[{"And", "@@", 
          RowBox[{RowBox[{"(", RowBox[{RowBox[{RowBox[{"ToString", "[", "#1", 
                    "]"}], "\[Equal]", "\"1\""}], "&"}], ")"}], "/@", 
            RowBox[{RowBox[{"Rest", "[", "comparisonRows", "]"}], 
              "\[LeftDoubleBracket]", RowBox[{"All", ",", "6"}], 
              "\[RightDoubleBracket]"}]}]}]}], ";", 
      RowBox[{"numericalComparisonStatus", "=", 
        RowBox[{"Association", "[", RowBox[{RowBox[{"\"common quantities\"", 
              "\[Rule]", RowBox[{"Length", "[", 
                "comparisonAbsoluteDifferences", "]"}]}], ",", 
            RowBox[{"\"largest absolute difference\"", "\[Rule]", 
              RowBox[{"Max", "[", "comparisonAbsoluteDifferences", "]"}]}], 
            ",", RowBox[
             {"\"all rows pass 1e-8 absolute-or-relative tolerance\"", 
              "\[Rule]", "comparisonPassed"}]}], "]"}]}], ";", 
      "numericalComparisonStatus"}]], "Input"], 
  Cell["13. Exact check summary", "Section"], 
  Cell[BoxData[RowBox[{RowBox[{"checkResiduals", "=", 
        RowBox[{"Association", "[", RowBox[
           {RowBox[{"\"tensor-current commutator\"", "\[Rule]", 
              "tensorVertexResidual"}], ",", RowBox[
             {"\"heavy Ward identity\"", "\[Rule]", "wardHeavyResidual"}], 
            ",", RowBox[{"\"strange Ward identity\"", "\[Rule]", 
              "wardStrangeResidual"}], ",", RowBox[
             {"\"E1 normalization minus one\"", "\[Rule]", 
              RowBox[{"Simplify", "[", RowBox[{"projectorNormalization", "-", 
                  "1"}], "]"}]}], ",", RowBox[{"\"photon Ward contraction\"", 
              "\[Rule]", "photonWard"}], ",", RowBox[
             {"\"heavy Feynman-parameter identity\"", "\[Rule]", 
              "heavyParameterResidual"}], ",", RowBox[
             {"\"strange Feynman-parameter identity\"", "\[Rule]", 
              "strangeParameterResidual"}], ",", RowBox[
             {"\"orthogonal state rotation\"", "\[Rule]", 
              "stateRotationResidual"}], ",", RowBox[
             {"\"pure-A projected invariant\"", "\[Rule]", 
              "pureAxialTransitionResidual"}], ",", 
            RowBox[{"\"pure-A residue-weighted coupling\"", "\[Rule]", 
              "pureAxialCouplingResidual"}], ",", 
            RowBox[{"\"two-point correlator rotation\"", "\[Rule]", 
              "correlationRotationResidual"}], ",", 
            RowBox[{"\"pure-A decay constant\"", "\[Rule]", 
              "pureAxialDecayConstantResidual"}], ",", 
            RowBox[{"\"Ds f1-anchor closure\"", "\[Rule]", 
              "rhoFromF1Residual"}], ",", RowBox[
             {"\"legacy Bs Pi12=0 closure diagnostic\"", "\[Rule]", 
              "rhoDiagResidual"}], ",", RowBox[
             {"\"Colangelo formula limit\"", "\[Rule]", 
              "colangeloFormulaResidual"}], ",", RowBox[{"\"pure-A width\"", 
              "\[Rule]", "pureAxialWidthResidual"}], ",", 
            RowBox[{"\"axial OPE component assembly\"", "\[Rule]", 
              "axialOPEAssemblyResidual"}], ",", RowBox[
             {"\"tensor OPE component assembly\"", "\[Rule]", 
              "tensorOPEAssemblyResidual"}], ",", 
            RowBox[{"\"three-particle operator assembly\"", "\[Rule]", 
              "threeParticleResiduals"}], ",", RowBox[
             {"\"mixed coupling component assembly\"", "\[Rule]", 
              "paperComponentAssemblyResidual"}], ",", 
            RowBox[{"\"full axial OPE pure-A limit\"", "\[Rule]", 
              "paperPureAxialResidual"}], ",", RowBox[
             {"\"signed-to-positive chi conversion\"", "\[Rule]", 
              "chiConventionResidual"}]}], "]"}]}], ";", 
      RowBox[{RowBox[{"zeroResidualQ", "[", "value_", "]"}], ":=", 
        RowBox[{"And", "@@", RowBox[{RowBox[{"(", RowBox[{RowBox[{"TrueQ", 
                  "[", RowBox[{"#1", "===", "0"}], "]"}], "&"}], ")"}], "/@", 
            RowBox[{"Flatten", "[", RowBox[{"{", "value", "}"}], "]"}]}]}]}], 
      ";", RowBox[{"Association", "[", 
        RowBox[{RowBox[{"\"residuals\"", "\[Rule]", "checkResiduals"}], ",", 
          RowBox[{"\"overall status\"", "\[Rule]", 
            RowBox[{"If", "[", RowBox[{RowBox[{"And", "@@", RowBox[
                   {"zeroResidualQ", "/@", RowBox[{"Values", "[", 
                      "checkResiduals", "]"}]}]}], ",", "\"PASS\"", ",", 
                "\"FAIL\""}], "]"}]}]}], "]"}]}]], "Input"], 
  Cell["For a clean batch regression run, execute \
scripts/mathematica_current_wick_trace_audit.wl, \
scripts/mathematica_correlator_routing_audit.wl, and \
scripts/mathematica_hard_loop_parameterization.wl. The state projection has \
its own scripts/mathematica_state_mixing_projection.wl audit. The Bs channel \
uses the same symbolic expressions with mQ -> mb and the appropriate \
heavy-quark charge.", "Text"]}, WindowTitle -> 
  "Ds/Bs gamma symbolic derivation", Saveable -> True, 
 StyleDefinitions -> "Default.nb"]
