            "pureAxialWidthResidual"}], ",", 
          RowBox[{"\"G interval overlap [GeV^-1]\"", "\[Rule]", 
            "gIntervalIntersection"}], ",", RowBox[
           {"\"width interval overlap [keV]\"", "\[Rule]", 
            "widthIntervalIntersectionKeV"}]}], "]"}]}]], "Input"], 
  Cell["Off-shell double-Borel identities and Rohrwild OPE assembly", 
   "Subsection"], Cell["On the QCD side p2 and pPrime2 remain independent \
until both Borel transforms have been applied. Pole-mass substitutions are \
allowed only in the phenomenological residue. The Rohrwild transition OPE \
contains no standalone local-condensate component; condensate factors can \
still normalize nonlocal photon DAs.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{RowBox[{"Dsoft", "[", "u_", "]"}], ":=", 
        RowBox[{SuperscriptBox["mQ", "2"], "-", 
          RowBox[{RowBox[{"(", RowBox[{"1", "-", "u"}], ")"}], " ", 
            "pPrime2"}], "-", RowBox[{"u", " ", "p2"}]}]}], ";", 
      RowBox[{"Meff2", "=", FractionBox[RowBox[{"M1sq", " ", "M2sq"}], 
         RowBox[{"M1sq", "+", "M2sq"}]]}], ";", 
      RowBox[{"u0B", "=", FractionBox["M1sq", RowBox[{"M1sq", "+", 
           "M2sq"}]]}], ";", RowBox[{RowBox[{"borelFactor", "[", "n_", "]"}], 
        ":=", FractionBox[RowBox[{SuperscriptBox["Meff2", 
            RowBox[{"2", "-", "n"}]], " ", RowBox[{"Exp", "[", 
             RowBox[{"-", FractionBox[SuperscriptBox["mQ", "2"], "Meff2"]}], 
             "]"}]}], RowBox[{"Gamma", "[", "n", "]"}]]}], ";", 
      RowBox[{RowBox[{"borelMaster", "[", RowBox[{"n_", ",", "Ffun_"}], 
          "]"}], ":=", RowBox[{RowBox[{"borelFactor", "[", "n", "]"}], " ", 
          RowBox[{"Ffun", "[", "u0B", "]"}]}]}], ";", 
      RowBox[{RowBox[{"borelPq", "[", RowBox[{"n_", ",", "Ffun_"}], "]"}], 
        ":=", FractionBox[RowBox[{RowBox[{"borelFactor", "[", 
             RowBox[{"n", "-", "1"}], "]"}], " ", 
           RowBox[{SuperscriptBox["Ffun", "\[Prime]", MultilineFunction -> 
               None], "[", "u0B", "]"}]}], RowBox[{"2", " ", 
           RowBox[{"(", RowBox[{"n", "-", "1"}], ")"}]}]]}], ";", 
      RowBox[{RowBox[{"borelPPrime2", "[", RowBox[{"n_", ",", "Ffun_"}], 
          "]"}], ":=", RowBox[{RowBox[{SuperscriptBox["mQ", "2"], " ", 
            RowBox[{"borelFactor", "[", "n", "]"}], " ", 
            RowBox[{"Ffun", "[", "u0B", "]"}]}], "-", 
          RowBox[{RowBox[{"borelFactor", "[", RowBox[{"n", "-", "1"}], "]"}], 
            " ", RowBox[{"Ffun", "[", "u0B", "]"}]}], "+", 
          FractionBox[RowBox[{RowBox[{"borelFactor", "[", RowBox[
                {"n", "-", "1"}], "]"}], " ", RowBox[{"(", RowBox[
                {RowBox[{SubscriptBox["\[PartialD]", RowBox[{"u"}]], 
                   RowBox[{"(", RowBox[{"u", " ", RowBox[{"Ffun", "[", "u", 
                         "]"}]}], ")"}]}], "/.", "\[VeryThinSpace]", 
                 RowBox[{"u", "\[Rule]", "u0B"}]}], ")"}]}], 
           RowBox[{"n", "-", "1"}]]}]}], ";", 
      RowBox[{RowBox[{"borelP2", "[", RowBox[{"n_", ",", "Ffun_"}], "]"}], 
        ":=", RowBox[{RowBox[{SuperscriptBox["mQ", "2"], " ", 
            RowBox[{"borelFactor", "[", "n", "]"}], " ", 
            RowBox[{"Ffun", "[", "u0B", "]"}]}], "-", 
          RowBox[{RowBox[{"borelFactor", "[", RowBox[{"n", "-", "1"}], "]"}], 
            " ", RowBox[{"Ffun", "[", "u0B", "]"}]}], "-", 
          FractionBox[RowBox[{RowBox[{"borelFactor", "[", RowBox[
                {"n", "-", "1"}], "]"}], " ", RowBox[{"(", RowBox[
                {RowBox[{SubscriptBox["\[PartialD]", RowBox[{"u"}]], 
                   RowBox[{"(", RowBox[{RowBox[{"(", RowBox[{"1", "-", "u"}], 
                         ")"}], " ", RowBox[{"Ffun", "[", "u", "]"}]}], 
                     ")"}]}], "/.", "\[VeryThinSpace]", RowBox[{"u", 
                   "\[Rule]", "u0B"}]}], ")"}]}], 
           RowBox[{"n", "-", "1"}]]}]}], ";", 
      RowBox[{"Association", "[", RowBox[{RowBox[{"\"D(u), before Borel\"", 
            "\[Rule]", RowBox[{"Dsoft", "[", "u", "]"}]}], ",", 
          RowBox[{"\"M_eff^2\"", "\[Rule]", "Meff2"}], ",", 
          RowBox[{"\"u0\"", "\[Rule]", "u0B"}], ",", 
          RowBox[{"\"B[Integral F/D^n]\"", "\[Rule]", 
            RowBox[{"borelMaster", "[", RowBox[{"n", ",", "Ffun"}], "]"}]}], 
          ",", RowBox[{"\"B[Integral (p.q) F/D^n]\"", "\[Rule]", 
            RowBox[{"borelPq", "[", RowBox[{"n", ",", "Ffun"}], "]"}]}], ",", 
