          "]"}]}], ";", RowBox[{"dsFoundResidues", "=", 
        RowBox[{"Association", "[", RowBox[
           {RowBox[{"\"legacy chi, theta=35.3 deg\"", "\[Rule]", 
              RowBox[{"Association", "[", RowBox[{RowBox[
