          ",", RowBox[{"\"B[Integral p^2 F/D^n]\"", "\[Rule]", 
            RowBox[{"borelP2", "[", RowBox[{"n", ",", "Ffun"}], "]"}]}]}], 
        "]"}]}]], "Input"], 
