   "Input"], Cell[BoxData[RowBox[{"KeyTake", "[", 
      RowBox[{"mathematicaCentral", ",", 
        RowBox[{"{", RowBox[{"\"Ds.g_1_A\"", ",", "\"Ds.g_1_B\"", ",", 
            "\"Ds.g_1\"", ",", "\"Ds.Gamma_1_keV\"", ",", "\"Ds.g_2_A\"", 
            ",", "\"Ds.g_2_B\"", ",", "\"Ds.g_2\"", ",", 
