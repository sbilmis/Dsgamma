              "ag"}], "]"}]}]}], ";", 
      RowBox[{RowBox[{"fGX", "[", RowBox[{"aq_", ",", "aqb_", ",", "ag_", 
            ",", "v_"}], "]"}], ":=", RowBox[{"2", " ", "v", " ", 
          RowBox[{"(", RowBox[{RowBox[{"-", RowBox[{"S3", "[", RowBox[
                   {"aq", ",", "aqb", ",", "ag"}], "]"}]}], "-", 
              RowBox[{"T33", "[", RowBox[{"aq", ",", "aqb", ",", "ag"}], 
                "]"}], "+", RowBox[{"T23", "[", RowBox[{"aq", ",", "aqb", 
                  ",", "ag"}], "]"}]}], ")"}]}]}], ";", 
      RowBox[{RowBox[{"fGA", "[", RowBox[{"aq_", ",", "aqb_", ",", "ag_", 
            ",", "v_"}], "]"}], ":=", 
        RowBox[{RowBox[{"fGSigma", "[", RowBox[{"aq", ",", "aqb", ",", "ag", 
              ",", "v"}], "]"}], "+", RowBox[{"fGX", "[", 
            RowBox[{"aq", ",", "aqb", ",", "ag", ",", "v"}], "]"}]}]}], ";", 
      RowBox[{RowBox[{"fGammaSigma", "[", RowBox[{"aq_", ",", "aqb_", ",", 
            "ag_", ",", "v_"}], "]"}], ":=", 
        RowBox[{RowBox[{"Sg3", "[", RowBox[{"aq", ",", "aqb", ",", "ag"}], 
            "]"}], "-", RowBox[{"T4g3", "[", RowBox[{"aq", ",", "aqb", ",", 
              "ag"}], "]"}]}]}], ";", 
      RowBox[{RowBox[{"fGammaA", "[", RowBox[{"aq_", ",", "aqb_", ",", "ag_", 
            ",", "v_"}], "]"}], ":=", 
        RowBox[{RowBox[{RowBox[{"(", RowBox[{"1", "-", RowBox[{"2", " ", 
                  "v"}]}], ")"}], " ", RowBox[{"Sg3", "[", RowBox[{"aq", ",", 
                "aqb", ",", "ag"}], "]"}]}], "-", 
          RowBox[{"T4g3", "[", RowBox[{"aq", ",", "aqb", ",", "ag"}], 
            "]"}]}]}], ";", RowBox[{"tA3g", "=", 
        RowBox[{"eS", " ", "ssCond", " ", "expQ", " ", 
          RowBox[{"lineProjection3", "[", RowBox[{"fGA", ",", "a0B"}], 
            "]"}]}]}], ";", RowBox[{"tB3g", "=", FractionBox[
         RowBox[{"eS", " ", "ssCond", " ", "expQ", " ", "mQ", " ", 
           RowBox[{"lineProjection3", "[", RowBox[{"fGSigma", ",", "a0B"}], 
             "]"}]}], RowBox[{"mQ", "+", "ms"}]]}], ";", 
      RowBox[{"tA3em", "=", RowBox[{"eQ", " ", "ssCond", " ", "deltaEQ", " ", 
          RowBox[{"(", RowBox[{RowBox[{"lineProjection3", "[", 
                RowBox[{"fGammaA", ",", "a0B"}], "]"}], "+", RowBox[{"2", 
                " ", RowBox[{"pLinePrime3", "[", RowBox[{"T4g3", ",", 
                    "a0B"}], "]"}]}]}], ")"}]}]}], ";", 
      RowBox[{"tB3em", "=", FractionBox[RowBox[{"eQ", " ", "ssCond", " ", 
           "deltaEQ", " ", "mQ", " ", RowBox[{"(", RowBox[
              {RowBox[{"lineProjection3", "[", RowBox[{"fGammaSigma", ",", 
                   "a0B"}], "]"}], "+", RowBox[{"2", " ", RowBox[
                  {"pLinePrime3", "[", RowBox[{"T4g3", ",", "a0B"}], 
                   "]"}]}]}], ")"}]}], RowBox[{"mQ", "+", "ms"}]]}], ";", 
      RowBox[{"threeParticleResiduals", "=", RowBox[{"FullSimplify", "/@", 
          RowBox[{"{", RowBox[{RowBox[{RowBox[{"fGA", "[", RowBox[{"aq", ",", 
                    "aqb", ",", "alphaG", ",", "v"}], "]"}], "-", 
                RowBox[{"fGSigma", "[", RowBox[{"aq", ",", "aqb", ",", 
                    "alphaG", ",", "v"}], "]"}], "-", RowBox[{"fGX", "[", 
                  RowBox[{"aq", ",", "aqb", ",", "alphaG", ",", "v"}], 
                  "]"}]}], ",", RowBox[{RowBox[{"fGammaA", "[", RowBox[
                   {"aq", ",", "aqb", ",", "alphaG", ",", "v"}], "]"}], "-", 
                RowBox[{"fGammaSigma", "[", RowBox[{"aq", ",", "aqb", ",", 
                    "alphaG", ",", "v"}], "]"}], "+", RowBox[{"2", " ", "v", 
                  " ", RowBox[{"Sg3", "[", RowBox[{"aq", ",", "aqb", ",", 
                      "alphaG"}], "]"}]}]}]}], "}"}]}]}], ";", 
      RowBox[{"Association", "[", RowBox[
         {RowBox[{"\"T_A three-particle gluonic\"", "\[Rule]", "tA3g"}], ",", 
          RowBox[{"\"T_B three-particle gluonic\"", "\[Rule]", "tB3g"}], ",", 
          RowBox[{"\"T_A three-particle electromagnetic\"", "\[Rule]", 
            "tA3em"}], ",", RowBox[{"\"T_B three-particle electromagnetic\"", 
            "\[Rule]", "tB3em"}], ",", RowBox[
           {"\"operator-weight residuals\"", "\[Rule]", 
            "threeParticleResiduals"}], ",", 
          RowBox[{"\"full assembly audit\"", "\[Rule]", "\"step15_complete_th\
ree_particle_borel.wl: four exact zero residuals\""}]}], "]"}]}]], "Input"], 
  Cell["Continuum bookkeeping is channel-specific.  The leading twist-2 term \
uses DeltaEQ=expQ-exp0.  Twist 3, twist 4, and the gluonic three-particle \
term retain the raw expQ factor of the Ds1-to-Ds-gamma sum rule.  The \
distinct gauge-completion electromagnetic three-particle term follows \
Rohrwild's IF-type DeltaEQ subtraction.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"axialOPEComponents", "=", 
        RowBox[{"Association", "[", RowBox[{RowBox[{"\"perturbative\"", 
              "\[Rule]", TemplateBox[{RowBox[{RowBox[{"Exp", "[", RowBox[
                     {"-", FractionBox["s", "M2"]}], "]"}], " ", 
                  RowBox[{"rhoA", "[", "s", "]"}]}], "s", SuperscriptBox[
                 RowBox[{"(", RowBox[{"mQ", "+", "ms"}], ")"}], "2"], "s0"}, 
               "InactiveIntegrate", DisplayFunction -> 
                (RowBox[{SubsuperscriptBox[StyleBox["\[Integral]", 
                     "Inactive"], #3, #4], RowBox[{#1, RowBox[{StyleBox[
                        "\[DifferentialD]", "Inactive"], #2}]}]}] & ), 
               InterpretationFunction -> (RowBox[{RowBox[{"Inactive", "[", 
                     "Integrate", "]"}], "[", RowBox[{#1, ",", RowBox[
                      {"{", RowBox[{#2, ",", #3, ",", #4}], "}"}]}], 
                   "]"}] & )]}], ",", RowBox[
             {"\"twist 2, positive-magnitude chi\"", "\[Rule]", 
              RowBox[{"eS", " ", "ssCond", " ", "deltaEQ", " ", "M2", " ", 
                "chiGamma", " ", RowBox[{"phiGamma", "[", "u0", "]"}]}]}], 
            ",", RowBox[{"\"twist 3\"", "\[Rule]", RowBox[{"eS", " ", 
                "f3Gamma", " ", "mQ", " ", "expQ", " ", RowBox[{"psiVBar", 
                  "[", "u0", "]"}]}]}], ",", RowBox[{"\"twist 4\"", 
              "\[Rule]", RowBox[{FractionBox["1", "4"], " ", "eS", " ", 
                "ssCond", " ", "expQ", " ", RowBox[{"(", RowBox[
                   {RowBox[{"A4", "[", "u0", "]"}], "+", RowBox[{"2", " ", 
                      RowBox[{"B4", "[", "u0", "]"}]}]}], ")"}], " ", 
                RowBox[{"(", RowBox[{"1", "+", FractionBox[SuperscriptBox[
                      "mQ", "2"], "M2"]}], ")"}]}]}], ",", 
            RowBox[{"\"three particle, gluonic\"", "\[Rule]", "tA3g"}], ",", 
            RowBox[{"\"three particle, electromagnetic\"", "\[Rule]", 
              "tA3em"}]}], "]"}]}], ";", 
      RowBox[{"tAHat", "=", RowBox[{"Total", "[", 
          RowBox[{"Values", "[", "axialOPEComponents", "]"}], "]"}]}], ";", 
      RowBox[{"axialOPEAssemblyResidual", "=", 
        RowBox[{"Expand", "[", RowBox[{"tAHat", "-", 
            RowBox[{"Total", "[", RowBox[{"Values", "[", 
                "axialOPEComponents", "]"}], "]"}]}], "]"}]}], ";", 
      RowBox[{"Association", "[", RowBox[{RowBox[{"\"T_A components\"", 
            "\[Rule]", "axialOPEComponents"}], ",", 
          RowBox[{"\"T_A\"", "\[Rule]", "tAHat"}], ",", 
          RowBox[{"\"assembly residual\"", "\[Rule]", 
            "axialOPEAssemblyResidual"}]}], "]"}]}]], "Input"], 
  Cell["Explicit post-double-Borel vector and x-gamma kernels", 
   "Subsection"], Cell["The Fourier reduction uses k=p+a q and D_a=mQ^2-a \
pPrime^2-(1-a)p2. The double Borel transform is applied before a0=1/2 is \
chosen. These expressions contain DA derivatives and no pole-mass \
substitution.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"a0B", "=", RowBox[{"1", "-", "u0"}]}], ";", 
      RowBox[{"tBTw2", "=", FractionBox[RowBox[{"mQ", " ", 
           RowBox[{"axialOPEComponents", "[", 
             "\"twist 2, positive-magnitude chi\"", "]"}]}], 
         RowBox[{"mQ", "+", "ms"}]]}], ";", 
      RowBox[{"tBTw3", "=", FractionBox[RowBox[{"eS", " ", "f3Gamma", " ", 
           "expQ", " ", RowBox[{"(", RowBox[{RowBox[{SuperscriptBox["mQ", 
                  "2"], " ", RowBox[{"psiVBar", "[", "a0B", "]"}]}], "-", 
               RowBox[{FractionBox["1", "2"], " ", "M2", " ", RowBox[
                  {"(", RowBox[{RowBox[{SubscriptBox["\[PartialD]", RowBox[
                         {"a"}]], RowBox[{"(", RowBox[{RowBox[{"(", RowBox[
                          {"1", "-", "a"}], ")"}], " ", RowBox[{"psiVBar", 
                          "[", "a", "]"}]}], ")"}]}], "/.", 
                     "\[VeryThinSpace]", RowBox[{"a", "\[Rule]", "a0B"}]}], 
                   ")"}]}]}], ")"}]}], RowBox[{"mQ", "+", "ms"}]]}], ";", 
      RowBox[{"tBTw4", "=", FractionBox[RowBox[{"mQ", " ", 
           RowBox[{"axialOPEComponents", "[", "\"twist 4\"", "]"}]}], 
         RowBox[{"mQ", "+", "ms"}]]}], ";", 
      RowBox[{"symmetricTw3", "=", RowBox[
         {RowBox[{"{", RowBox[{RowBox[{RowBox[{"axialOPEComponents", "[", 
                  "\"twist 3\"", "]"}], "/.", "\[VeryThinSpace]", 
                RowBox[{"u0", "\[Rule]", FractionBox["1", "2"]}]}], ",", 
              RowBox[{"tBTw3", "/.", "\[VeryThinSpace]", RowBox[
                 {"u0", "\[Rule]", FractionBox["1", "2"]}]}]}], "}"}], "/.", 
          "\[VeryThinSpace]", RowBox[{RowBox[{"psiVBar", "[", 
              FractionBox["1", "2"], "]"}], "\[Rule]", "0"}]}]}], ";", 
      RowBox[{"Association", "[", RowBox[{RowBox[{"\"T_B twist 2\"", 
            "\[Rule]", "tBTw2"}], ",", RowBox[{"\"T_B twist 3\"", "\[Rule]", 
            "tBTw3"}], ",", RowBox[{"\"T_B twist 4\"", "\[Rule]", "tBTw4"}], 
          ",", RowBox[{"\"symmetric twist-3 pair\"", "\[Rule]", 
            "symmetricTw3"}]}], "]"}]}]], "Input"], 
  Cell[BoxData[RowBox[{RowBox[{RowBox[{"xAS", "[", "f_", "]"}], ":=", 
        RowBox[{RowBox[{"-", "8"}], " ", "expQ", " ", 
          RowBox[{"f", "[", "a0B", "]"}]}]}], ";", 
      RowBox[{RowBox[{"xAT1", "[", "f_", "]"}], ":=", 
        RowBox[{"48", " ", "\[ImaginaryI]", " ", "expQ", " ", 
          RowBox[{"f", "[", "a0B", "]"}]}]}], ";", 
      RowBox[{RowBox[{"xAT2", "[", "f_", "]"}], ":=", 
        RowBox[{"16", " ", "\[ImaginaryI]", " ", "expQ", " ", 
          RowBox[{"f", "[", "a0B", "]"}]}]}], ";", 
      RowBox[{RowBox[{"xAT3", "[", "f_", "]"}], ":=", 
        RowBox[{RowBox[{"-", "16"}], " ", "\[ImaginaryI]", " ", "expQ", " ", 
          RowBox[{"f", "[", "a0B", "]"}]}]}], ";", 
      RowBox[{RowBox[{"xAT4", "[", "f_", "]"}], ":=", "0"}], ";", 
      RowBox[{RowBox[{"xBS", "[", "f_", "]"}], ":=", "0"}], ";", 
      RowBox[{RowBox[{"xBT1", "[", "f_", "]"}], ":=", "0"}], ";", 
      RowBox[{RowBox[{"xBT2", "[", "f_", "]"}], ":=", "0"}], ";", 
      RowBox[{RowBox[{"xBT3", "[", "f_", "]"}], ":=", "0"}], ";", 
      RowBox[{RowBox[{"xBT4", "[", "f_", "]"}], ":=", "0"}], ";", 
      RowBox[{"Association", "[", RowBox[{RowBox[{"\"A xgamma kernels\"", 
            "\[Rule]", RowBox[{"{", RowBox[{RowBox[{"xAS", "[", "Feff", 
                  "]"}], ",", RowBox[{"xAT1", "[", "Feff", "]"}], ",", 
                RowBox[{"xAT2", "[", "Feff", "]"}], ",", RowBox[{"xAT3", "[", 
                  "Feff", "]"}], ",", RowBox[{"xAT4", "[", "Feff", "]"}]}], 
              "}"}]}], ",", RowBox[{"\"B xgamma kernels\"", "\[Rule]", 
            RowBox[{"{", RowBox[{RowBox[{"xBS", "[", "Feff", "]"}], ",", 
                RowBox[{"xBT1", "[", "Feff", "]"}], ",", RowBox[{"xBT2", "[", 
                  "Feff", "]"}], ",", RowBox[{"xBT3", "[", "Feff", "]"}], 
                ",", RowBox[{"xBT4", "[", "Feff", "]"}]}], "}"}]}], ",", 
          RowBox[{"\"sigma coefficients A\"", "\[Rule]", 
            RowBox[{"{", RowBox[{"8", ",", RowBox[{RowBox[{"-", "16"}], " ", 
                  "\[ImaginaryI]"}]}], "}"}]}], ",", 
          RowBox[{"\"sigma coefficients B\"", "\[Rule]", 
            RowBox[{"{", RowBox[{FractionBox[RowBox[{"8", " ", "mQ"}], 
                 RowBox[{"mQ", "+", "ms"}]], ",", RowBox[{"-", FractionBox[
                   RowBox[{"16", " ", "\[ImaginaryI]", " ", "mQ"}], 
                   RowBox[{"mQ", "+", "ms"}]]}]}], "}"}]}]}], "]"}]}]], 
   "Input"], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"lambdaB", "[", RowBox[{"shat_", ",", "mi_", ",", 
            "mj_"}], "]"}], ":=", RowBox[{"kallenLambda", "[", 
          RowBox[{"shat", ",", SuperscriptBox["mj", "2"], ",", 
            SuperscriptBox["mi", "2"]}], "]"}]}], ";", 
      RowBox[{RowBox[{"rhoBLeg", "[", RowBox[{"shat_", ",", "mi_", ",", 
            "mj_", ",", "aa_", ",", "bb_"}], "]"}], ":=", 
        RowBox[{"-", FractionBox[RowBox[{"3", " ", RowBox[{"(", RowBox[
                {RowBox[{"2", " ", "aa", " ", RowBox[{"Log", "[", FractionBox[
                      RowBox[{"shat", "-", SuperscriptBox["mj", "2"], "+", 
                        SuperscriptBox["mi", "2"], "-", SqrtBox[RowBox[
                          {"lambdaB", "[", RowBox[{"shat", ",", "mi", ",", 
                          "mj"}], "]"}]]}], RowBox[{"shat", "-", 
                        SuperscriptBox["mj", "2"], "+", SuperscriptBox["mi", 
                         "2"], "+", SqrtBox[RowBox[{"lambdaB", "[", RowBox[
                          {"shat", ",", "mi", ",", "mj"}], "]"}]]}]], 
                     "]"}]}], "+", FractionBox[RowBox[{"bb", " ", RowBox[
                     {"(", RowBox[{SuperscriptBox["mj", "2"], "-", 
                        SuperscriptBox["mi", "2"], "-", "shat"}], ")"}], " ", 
                    SqrtBox[RowBox[{"lambdaB", "[", RowBox[{"shat", ",", 
                         "mi", ",", "mj"}], "]"}]]}], RowBox[{SuperscriptBox[
                     "mi", "2"], " ", SuperscriptBox["shat", "2"]}]]}], 
               ")"}]}], RowBox[{"8", " ", SuperscriptBox["\[Pi]", 
              "2"]}]]}]}], ";", RowBox[{"aScoef", "=", 
        FractionBox[RowBox[{"mQ", " ", "ms"}], RowBox[{"mQ", "+", "ms"}]]}], 
      ";", RowBox[{RowBox[{"bScoef", "[", "shat_", "]"}], ":=", 
        FractionBox[RowBox[{SuperscriptBox["ms", "2"], " ", "shat"}], 
         RowBox[{"mQ", "+", "ms"}]]}], ";", 
      RowBox[{"aQcoef", "=", FractionBox[
         RowBox[{RowBox[{"2", " ", SuperscriptBox["mQ", "2"]}], "-", 
           RowBox[{"mQ", " ", "ms"}]}], RowBox[{"mQ", "+", "ms"}]]}], ";", 
      RowBox[{RowBox[{"bQcoef", "[", "shat_", "]"}], ":=", 
        RowBox[{"-", FractionBox[RowBox[{SuperscriptBox["mQ", "2"], " ", 
             "shat"}], RowBox[{"mQ", "+", "ms"}]]}]}], ";", 
      RowBox[{RowBox[{"rhoB", "[", "shat_", "]"}], ":=", 
        RowBox[{RowBox[{"eS", " ", RowBox[{"rhoBLeg", "[", RowBox[{"shat", 
                ",", "ms", ",", "mQ", ",", "aScoef", ",", RowBox[{"bScoef", 
                  "[", "shat", "]"}]}], "]"}]}], "-", 
          RowBox[{"eQ", " ", RowBox[{"rhoBLeg", "[", RowBox[{"shat", ",", 
                "mQ", ",", "ms", ",", "aQcoef", ",", RowBox[{"bQcoef", "[", 
                  "shat", "]"}]}], "]"}]}]}]}], ";", 
      RowBox[{"tBpert", "=", TemplateBox[
         {RowBox[{RowBox[{"Exp", "[", RowBox[{"-", FractionBox["s", "M2"]}], 
              "]"}], " ", RowBox[{"rhoB", "[", "s", "]"}]}], "s", 
          SuperscriptBox[RowBox[{"(", RowBox[{"mQ", "+", "ms"}], ")"}], "2"], 
          "s0"}, "InactiveIntegrate", DisplayFunction -> 
          (RowBox[{SubsuperscriptBox[StyleBox["\[Integral]", "Inactive"], #3, 
              #4], RowBox[{#1, RowBox[{StyleBox["\[DifferentialD]", 
                  "Inactive"], #2}]}]}] & ), InterpretationFunction -> 
          (RowBox[{RowBox[{"Inactive", "[", "Integrate", "]"}], "[", 
             RowBox[{#1, ",", RowBox[{"{", RowBox[{#2, ",", #3, ",", #4}], 
                 "}"}]}], "]"}] & )]}], ";", 
      RowBox[{"tensorOPEComponents", "=", RowBox[{"Association", "[", 
          RowBox[{RowBox[{"\"perturbative\"", "\[Rule]", "tBpert"}], ",", 
            RowBox[{"\"twist 2\"", "\[Rule]", "tBTw2"}], ",", 
            RowBox[{"\"twist 3\"", "\[Rule]", "tBTw3"}], ",", 
            RowBox[{"\"twist 4\"", "\[Rule]", "tBTw4"}], ",", 
            RowBox[{"\"three particle, gluonic\"", "\[Rule]", "tB3g"}], ",", 
            RowBox[{"\"three particle, electromagnetic\"", "\[Rule]", 
              "tB3em"}]}], "]"}]}], ";", 
      RowBox[{"tBHat", "=", RowBox[{"Total", "[", 
          RowBox[{"Values", "[", "tensorOPEComponents", "]"}], "]"}]}], ";", 
      RowBox[{"tensorOPEAssemblyResidual", "=", 
        RowBox[{"Expand", "[", RowBox[{"tBHat", "-", 
            RowBox[{"Total", "[", RowBox[{"Values", "[", 
                "tensorOPEComponents", "]"}], "]"}]}], "]"}]}], ";", 
      RowBox[{"tensorOPEStatus", "=", RowBox[{"Association", "[", 
          RowBox[{RowBox[{"\"perturbative\"", "\[Rule]", 
              "\"explicit diagonal spectral density\""}], ",", 
            RowBox[{"\"ordinary local quark condensate\"", "\[Rule]", 
              "\"absent in Rohrwild transition OPE\""}], ",", 
            RowBox[{"\"twist 2\"", "\[Rule]", 
              "\"kinematics-independent trace ratio derived\""}], ",", 
            RowBox[{"\"twist 3\"", "\[Rule]", 
              "\"explicit post-Borel DA-derivative form derived\""}], ",", 
            RowBox[{"\"twist 4\"", "\[Rule]", 
              "\"kinematics-independent trace ratio derived\""}], ",", 
            RowBox[{"\"three particle, gluonic\"", "\[Rule]", 
              "\"complete operator-weighted post-Borel convolution\""}], ",", 
            RowBox[{"\"three particle, electromagnetic\"", "\[Rule]", 
              "\"complete support-corrected post-Borel convolution\""}]}], 
          "]"}]}], ";", RowBox[{"Association", "[", 
        RowBox[{RowBox[{"\"T_B components\"", "\[Rule]", 
            "tensorOPEComponents"}], ",", RowBox[{"\"T_B\"", "\[Rule]", 
            "tBHat"}], ",", RowBox[{"\"status\"", "\[Rule]", 
            "tensorOPEStatus"}], ",", RowBox[{"\"assembly residual\"", 
            "\[Rule]", "tensorOPEAssemblyResidual"}]}], "]"}]}]], "Input"], 
  Cell[BoxData[RowBox[{RowBox[{"paperNorm1", "=", FractionBox[
         RowBox[{RowBox[{"Exp", "[", FractionBox[RowBox[{SuperscriptBox["m1", 
                 "2"], "+", SuperscriptBox["mP", "2"]}], RowBox[{"2", " ", 
                "M2"}]], "]"}], " ", RowBox[{"(", RowBox[{"mQ", "+", "ms"}], 
             ")"}]}], RowBox[{"m1", " ", "f1", " ", SuperscriptBox["mP", 
            "2"], " ", "fP"}]]}], ";", RowBox[{"paperNorm2", "=", 
        FractionBox[RowBox[{RowBox[{"Exp", "[", FractionBox[
              RowBox[{SuperscriptBox["m2", "2"], "+", SuperscriptBox["mP", 
                 "2"]}], RowBox[{"2", " ", "M2"}]], "]"}], " ", 
           RowBox[{"(", RowBox[{"mQ", "+", "ms"}], ")"}]}], 
         RowBox[{"m2", " ", "f2", " ", SuperscriptBox["mP", "2"], " ", 
           "fP"}]]}], ";", RowBox[{"paperG1", "=", 
        RowBox[{"paperNorm1", " ", RowBox[{"(", RowBox[
             {RowBox[{RowBox[{"Sin", "[", "theta", "]"}], " ", "tAHat"}], 
              "+", RowBox[{RowBox[{"Cos", "[", "theta", "]"}], " ", 
                "tBHat"}]}], ")"}]}]}], ";", 
      RowBox[{"paperG2", "=", RowBox[{"paperNorm2", " ", 
          RowBox[{"(", RowBox[{RowBox[{RowBox[{"Cos", "[", "theta", "]"}], 
                " ", "tAHat"}], "-", RowBox[{RowBox[{"Sin", "[", "theta", 
                  "]"}], " ", "tBHat"}]}], ")"}]}]}], ";", 
      RowBox[{"paperG1FromComponents", "=", RowBox[{"paperNorm1", " ", 
          RowBox[{"Total", "[", RowBox[{RowBox[{RowBox[{"Sin", "[", "theta", 
                  "]"}], " ", RowBox[{"Values", "[", "axialOPEComponents", 
                  "]"}]}], "+", RowBox[{RowBox[{"Cos", "[", "theta", "]"}], 
                " ", RowBox[{"Values", "[", "tensorOPEComponents", "]"}]}]}], 
            "]"}]}]}], ";", RowBox[{"paperComponentAssemblyResidual", "=", 
        RowBox[{"Expand", "[", RowBox[{"paperG1", "-", 
            "paperG1FromComponents"}], "]"}]}], ";", 
      RowBox[{"paperPureAxialResidual", "=", RowBox[{"Simplify", "[", 
          RowBox[{RowBox[{"(", RowBox[{"paperG1", "/.", "\[VeryThinSpace]", 
                RowBox[{"{", RowBox[{RowBox[{"theta", "\[Rule]", FractionBox[
                       "\[Pi]", "2"]}], ",", RowBox[{"f1", "\[Rule]", 
                      "fA"}]}], "}"}]}], ")"}], "-", FractionBox[
             RowBox[{RowBox[{"Exp", "[", FractionBox[RowBox[{SuperscriptBox[
                     "m1", "2"], "+", SuperscriptBox["mP", "2"]}], 
                  RowBox[{"2", " ", "M2"}]], "]"}], " ", RowBox[
                {"(", RowBox[{"mQ", "+", "ms"}], ")"}], " ", "tAHat"}], 
             RowBox[{"m1", " ", "fA", " ", SuperscriptBox["mP", "2"], " ", 
               "fP"}]]}], "]"}]}], ";", RowBox[{"chiConventionResidual", "=", 
        RowBox[{"Simplify", "[", RowBox[{RowBox[{"axialOPEComponents", "[", 
              "\"twist 2, positive-magnitude chi\"", "]"}], "-", 
            RowBox[{"eS", " ", "ssCond", " ", "deltaEQ", " ", "M2", " ", 
              "chiGamma", " ", RowBox[{"phiGamma", "[", "u0", "]"}]}]}], 
          "]"}]}], ";", RowBox[{"Association", "[", 
        RowBox[{RowBox[{"\"G_1 final\"", "\[Rule]", "paperG1"}], ",", 
          RowBox[{"\"G_2 final\"", "\[Rule]", "paperG2"}], ",", 
          RowBox[{"\"component assembly residual\"", "\[Rule]", 
            "paperComponentAssemblyResidual"}], ",", 
          RowBox[{"\"theta=Pi/2 Colangelo residual\"", "\[Rule]", 
            "paperPureAxialResidual"}], ",", 
          RowBox[{"\"chi-convention residual\"", "\[Rule]", 
            "chiConventionResidual"}]}], "]"}]}]], "Input"], 
  Cell["12. Corrected numerical transition evaluation", "Section"], 
  Cell["This section runs the independent Mathematica numerical \
implementation of the exact post-double-Borel Rohrwild expressions.  It \
evaluates the operator-weighted gluonic and electromagnetic convolutions, the \
complete T_A and T_B component sums, the physical g1 and g2 projections, and \
the radiative widths.  The ordinary local transition condensate is fixed to \
zero. The Python table is used only after the Mathematica calculation, as a \
term-by-term regression comparison.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"notebookPaperDir", "=", 
        RowBox[{"Quiet", "[", RowBox[{"Check", "[", 
            RowBox[{RowBox[{"ParentDirectory", "[", RowBox[
                 {"NotebookDirectory", "[", "]"}], "]"}], ",", 
              RowBox[{"DirectoryName", "[", RowBox[{"DirectoryName", "[", 
                  "$InputFileName", "]"}], "]"}]}], "]"}], "]"}]}], ";", 
      RowBox[{"If", "[", RowBox[{RowBox[{"!", RowBox[{"DirectoryQ", "[", 
              "notebookPaperDir", "]"}]}], ",", RowBox[{"notebookPaperDir", 
            "=", RowBox[{"DirectoryName", "[", RowBox[{"DirectoryName", "[", 
                "$InputFileName", "]"}], "]"}]}]}], "]"}], ";", 
      RowBox[{"wolframKernelPath", "=", 
        "\"/Applications/Wolfram.app/Contents/MacOS/WolframKernel\""}], ";", 
      RowBox[{"numericalScriptPath", "=", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{"notebookPaperDir", ",", "\"scripts\"", ",", 
              "\"mathematica_corrected_transition_numerics.wl\""}], "}"}], 
          "]"}]}], ";", RowBox[{"numericalRun", "=", 
        RowBox[{"RunProcess", "[", RowBox[
           {RowBox[{"{", RowBox[{"wolframKernelPath", ",", "\"-noinit\"", 
                ",", "\"-noprompt\"", ",", "\"-script\"", ",", 
                "numericalScriptPath"}], "}"}], ",", "All", ",", 
            RowBox[{"ProcessDirectory", "\[Rule]", "notebookPaperDir"}]}], 
          "]"}]}], ";", RowBox[{"Association", "[", 
        RowBox[{RowBox[{"\"exit code\"", "\[Rule]", 
            RowBox[{"numericalRun", "[", "\"ExitCode\"", "]"}]}], ",", 
          RowBox[{"\"script\"", "\[Rule]", "numericalScriptPath"}], ",", 
          RowBox[{"\"local transition condensate\"", "\[Rule]", 
            "\"excluded\""}]}], "]"}]}]], "Input"], 
  Cell[BoxData[RowBox[{RowBox[{RowBox[{"parseNumericText", "[", 
          RowBox[{"value_", "?", "NumericQ"}], "]"}], ":=", 
        RowBox[{"N", "[", RowBox[{"value", ",", "17"}], "]"}]}], ";", 
      RowBox[{RowBox[{"parseNumericText", "[", "value_String", "]"}], ":=", 
        RowBox[{"N", "[", RowBox[{RowBox[{"ToExpression", "[", 
              RowBox[{"StringReplace", "[", RowBox[{"value", ",", 
                  RowBox[{"{", RowBox[{RowBox[{"\"e+\"", "\[Rule]", 
                        "\"*^\""}], ",", RowBox[{"\"e-\"", "\[Rule]", 
                        "\"*^-\""}]}], "}"}]}], "]"}], "]"}], ",", "17"}], 
          "]"}]}], ";", RowBox[{"mathematicaCentralPath", "=", 
        RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{"notebookPaperDir", 
              ",", "\"outputs\"", ",", 
              "\"corrected_transition_central_mathematica.csv\""}], "}"}], 
          "]"}]}], ";", RowBox[{"mathematicaCentralRows", "=", 
        RowBox[{"Import", "[", RowBox[{"mathematicaCentralPath", ",", 
            "\"CSV\""}], "]"}]}], ";", RowBox[{"mathematicaCentral", "=", 
        RowBox[{"Association", "[", RowBox[
           {RowBox[{"(", RowBox[{RowBox[{RowBox[{"#1", 
                    "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                  "\[Rule]", RowBox[{"parseNumericText", "[", RowBox[
                     {"#1", "\[LeftDoubleBracket]", "2", 
                      "\[RightDoubleBracket]"}], "]"}]}], "&"}], ")"}], "/@", 
            RowBox[{"Rest", "[", "mathematicaCentralRows", "]"}]}], "]"}]}], 
      ";", RowBox[{"KeyTake", "[", RowBox[{"mathematicaCentral", ",", 
          RowBox[{"{", RowBox[{"\"convolution.J_g_sigma\"", ",", 
              "\"convolution.J_g_xgamma\"", ",", "\"convolution.J_g_axial\"", 
              ",", "\"convolution.J_em_axial\"", ",", 
              "\"convolution.J_em_tensor_base\"", ",", 
              "\"convolution.L_T4gamma\"", ",", 
              "\"convolution.Lprime_T4gamma\""}], "}"}]}], "]"}]}]], 
   "Input"], Cell[BoxData[RowBox[{"KeyTake", "[", 
      RowBox[{"mathematicaCentral", ",", 
        RowBox[{"{", RowBox[{"\"Ds.T_A_pert\"", ",", "\"Ds.T_A_tw2\"", ",", 
            "\"Ds.T_A_tw3\"", ",", "\"Ds.T_A_tw4\"", ",", "\"Ds.T_A_3p_g\"", 
