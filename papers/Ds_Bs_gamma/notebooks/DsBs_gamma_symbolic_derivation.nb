  Cell["The following overlap cell is retained only as a historical \
regression of the superseded normalization shortcut. The current Ds result \
from the complete matrix is f1=0.4046[0.3799,0.4291] GeV and \
f2=0.1677[0.1594,0.1756] GeV at theta=26.6+/-0.6 degrees; neither is \
anchored.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"f1ModelSquared", "=", 
        RowBox[{RowBox[{SuperscriptBox[RowBox[{"Sin", "[", "theta", "]"}], 
             "2"], " ", SuperscriptBox["fA", "2"]}], "+", 
          RowBox[{SuperscriptBox[RowBox[{"Cos", "[", "theta", "]"}], "2"], 
            " ", SuperscriptBox["fB", "2"]}], "+", 
          RowBox[{"2", " ", RowBox[{"Sin", "[", "theta", "]"}], " ", 
            RowBox[{"Cos", "[", "theta", "]"}], " ", "rhoAB", " ", "fA", " ", 
            "fB"}]}]}], ";", RowBox[{"f2ModelSquared", "=", 
        RowBox[{RowBox[{SuperscriptBox[RowBox[{"Cos", "[", "theta", "]"}], 
             "2"], " ", SuperscriptBox["fA", "2"]}], "+", 
          RowBox[{SuperscriptBox[RowBox[{"Sin", "[", "theta", "]"}], "2"], 
            " ", SuperscriptBox["fB", "2"]}], "-", 
          RowBox[{"2", " ", RowBox[{"Sin", "[", "theta", "]"}], " ", 
            RowBox[{"Cos", "[", "theta", "]"}], " ", "rhoAB", " ", "fA", " ", 
            "fB"}]}]}], ";", RowBox[{"rhoFromF1", "=", 
        FractionBox[RowBox[{SuperscriptBox["f1", "2"], "-", 
           RowBox[{SuperscriptBox[RowBox[{"Sin", "[", "theta", "]"}], "2"], 
             " ", SuperscriptBox["fA", "2"]}], "-", 
           RowBox[{SuperscriptBox[RowBox[{"Cos", "[", "theta", "]"}], "2"], 
             " ", SuperscriptBox["fB", "2"]}]}], 
         RowBox[{"2", " ", RowBox[{"Sin", "[", "theta", "]"}], " ", 
           RowBox[{"Cos", "[", "theta", "]"}], " ", "fA", " ", "fB"}]]}], 
      ";", RowBox[{"rhoFromF1Residual", "=", RowBox[{"Simplify", "[", 
          RowBox[{RowBox[{"(", RowBox[{"f1ModelSquared", "/.", 
                "\[VeryThinSpace]", RowBox[{"rhoAB", "\[Rule]", 
                  "rhoFromF1"}]}], ")"}], "-", SuperscriptBox["f1", "2"]}], 
          "]"}]}], ";", RowBox[{"f2FromF1Anchor", "=", 
        SqrtBox[RowBox[{"Simplify", "[", RowBox[{"f2ModelSquared", "/.", 
             "\[VeryThinSpace]", RowBox[{"rhoAB", "\[Rule]", "rhoFromF1"}]}], 
           "]"}]]}], ";", RowBox[{"pi12Model", "=", 
        RowBox[{RowBox[{RowBox[{"Sin", "[", "theta", "]"}], " ", 
            RowBox[{"Cos", "[", "theta", "]"}], " ", 
            RowBox[{"(", RowBox[{SuperscriptBox["fA", "2"], "-", 
                SuperscriptBox["fB", "2"]}], ")"}]}], "+", 
          RowBox[{RowBox[{"(", RowBox[{SuperscriptBox[RowBox[{"Cos", "[", 
                   "theta", "]"}], "2"], "-", SuperscriptBox[RowBox[
                  {"Sin", "[", "theta", "]"}], "2"]}], ")"}], " ", "rhoAB", 
            " ", "fA", " ", "fB"}]}]}], ";", 
      RowBox[{"rhoDiag", "=", RowBox[{"-", FractionBox[
           RowBox[{RowBox[{"Sin", "[", "theta", "]"}], " ", 
             RowBox[{"Cos", "[", "theta", "]"}], " ", 
             RowBox[{"(", RowBox[{SuperscriptBox["fA", "2"], "-", 
                 SuperscriptBox["fB", "2"]}], ")"}]}], 
           RowBox[{RowBox[{"(", RowBox[{SuperscriptBox[RowBox[{"Cos", "[", 
                    "theta", "]"}], "2"], "-", SuperscriptBox[RowBox[
                   {"Sin", "[", "theta", "]"}], "2"]}], ")"}], " ", "fA", 
             " ", "fB"}]]}]}], ";", RowBox[{"rhoDiagResidual", "=", 
