      RowBox[{RowBox[{"intervalOverlap", "[", RowBox[{"first_", ",", 
            "second_"}], "]"}], ":=", 
        RowBox[{"{", RowBox[{RowBox[{"Max", "[", RowBox[{RowBox[{"first", 
                  "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                ",", RowBox[{"second", "\[LeftDoubleBracket]", "1", 
                  "\[RightDoubleBracket]"}]}], "]"}], ",", 
            RowBox[{"Min", "[", RowBox[{RowBox[{"first", 
                  "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                ",", RowBox[{"second", "\[LeftDoubleBracket]", "2", 
                  "\[RightDoubleBracket]"}]}], "]"}]}], "}"}]}], ";", 
      RowBox[{"gIntervalIntersection", "=", RowBox[{"intervalOverlap", "[", 
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"-", "0.3978`"}], ",", 
                RowBox[{"-", "0.3124`"}]}], "}"}], ",", 
            RowBox[{"{", RowBox[{RowBox[{"-", "0.37`"}], ",", RowBox[
                 {"-", "0.29`"}]}], "}"}]}], "]"}]}], ";", 
      RowBox[{"widthIntervalIntersectionKeV", "=", 
        RowBox[{"intervalOverlap", "[", RowBox[
           {RowBox[{"{", RowBox[{"20.51`", ",", "33.26`"}], "}"}], ",", 
            RowBox[{"{", RowBox[{"19.`", ",", "29.`"}], "}"}]}], "]"}]}], 
