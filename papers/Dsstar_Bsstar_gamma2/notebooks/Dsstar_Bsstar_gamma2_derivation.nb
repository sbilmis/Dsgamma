  Cell["1. Conventions and currents", "Section"], 
  Cell["Metric (+---), epsilon^0123=+1, p'=p+q, q^2=0. Basis currents: \
JA=bar(s) gamma_mu gamma5 Q and JB=i bar(s) sigma_mu_nu p'^nu gamma5 \
Q/(mQ+ms).", "Text"], 
  Cell[BoxData[RowBox[
     {"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"1", ",", "0", 
                ",", "0", ",", "0"}], "}"}], ",", 
